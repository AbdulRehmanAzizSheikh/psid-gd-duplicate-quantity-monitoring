# ---------------------------------------------------------------------------
# Copy to .env.local (Next.js auto-loads it). ALL variables are OPTIONAL:
# the app runs out of the box in "memory mode" + local proof uploads without
# any of these, using seed/sample data.
# ---------------------------------------------------------------------------

# --- MongoDB (database storage) ---
# Any MongoDB URI: Atlas (mongodb+srv://...) or local mongod (mongodb://127.0.0.1:27017/psid-gd-monitor)
MONGODB_URI=mongodb://127.0.0.1:27017/psid-gd-monitor
# Optional alias also supported:
# MONGO_URI=

# --- Cloudinary (custom-paid proof image/document storage) ---
# Find these in your Cloudinary dashboard. If unset, proofs fall back to local /public/uploads.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# Optional folder for uploaded proofs (default: psid-gd-proofs)
CLOUDINARY_FOLDER=psid-gd-proofs
